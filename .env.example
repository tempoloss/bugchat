# --- Telegram -------------------------------------------------------------
# Токен от @BotFather. Боту нужен доступ ко ВСЕМ сообщениям группы:
#   либо /setprivacy -> Disable в BotFather, либо (проще) сделать бота админом чата.
# Реакции (отмена через 👎) приходят ТОЛЬКО админам — админ всё равно нужен.
BUGBOT_TELEGRAM_TOKEN = "123456:AA..."

# ID чатов через запятую. Не знаете id — оставьте пустым, запустите бота
# и напишите в чат /chatid: бот ответит своим id (и залогирует его).
BUGBOT_CHAT_IDS = ""

# --- Plane ----------------------------------------------------------------
PLANE_BASE = "https://plane.example.com"
PLANE_WORKSPACE = "your-workspace"
PLANE_EMAIL = "you@example.com"
PLANE_PASSWORD = "..."
# Проект, куда падают баги: идентификатор (OPS) или имя проекта
BUGBOT_PLANE_PROJECT = "OPS"
# Состояние для новых задач и для отменённых
BUGBOT_PLANE_STATE = "Backlog"
BUGBOT_PLANE_CANCEL_STATE = "Cancelled"
# Метки на КАЖДУЮ задачу от бота (создаются автоматически)
BUGBOT_PLANE_LABELS = "telegram"
# Метка по виду: жалоба или заявка на функционал. Вешается вдобавок к общим.
BUGBOT_PLANE_BUG_LABEL = "bug"
BUGBOT_PLANE_FEATURE_LABEL = "feature"
# 1 — не проверять TLS (внутренний CA не установлен)
PLANE_INSECURE = "1"

# --- Поведение ------------------------------------------------------------
# Сообщение без медиа и без баг-лексики считается багом от такой длины
BUGBOT_MIN_TEXT_LEN = "120"
# Сколько ждать остальные части альбома, сек
BUGBOT_ALBUM_DEBOUNCE = "2.0"
# long-poll getUpdates, сек
BUGBOT_POLL_TIMEOUT = "25"
# Файлы больше этого размера не тянем (лимит Bot API всё равно 20 МБ)
BUGBOT_MAX_ATTACHMENT_MB = "20"
# Как часто спрашивать Plane про закрытые задачи (сек). 0 — не следить и не отвечать в чат
BUGBOT_CLOSE_POLL_SECONDS = "60"
# Сколько молчания ждать, прежде чем считать серию сообщений одного автора законченной.
# Один баг часто расписывают в 2-3 сообщения — они склеятся в одну задачу.
BUGBOT_BURST_SECONDS = "20"
# Сколько дней помнить сообщения чата (нужно для `/task N`)
BUGBOT_MESSAGE_LOG_DAYS = "7"
# Путь к файлу состояния
BUGBOT_DB = "state.db"
